# Server-resolved owner context for this local Streamlit instance.
# Never take this value from query parameters or browser-controlled input.
AI_JOB_SEARCH_USER_ID=00000000-0000-0000-0000-000000000000

# Dashboard discovery crawls a bounded number of verified ATS boards per run (default: 8).
AI_JOB_SEARCH_ATS_BOARD_BUDGET=8

# Existing server-side credentials; keep real values in your ignored .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
OPENAI_API_KEY=your-openai-api-key
