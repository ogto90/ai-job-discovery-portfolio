{
  "name": "weworkremotely-cli",
  "version": "1.0.0",
  "description": "CLI for searching We Work Remotely's public RSS feed.",
  "type": "module",
  "main": "src/cli.ts",
  "bin": {
    "weworkremotely-search": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
