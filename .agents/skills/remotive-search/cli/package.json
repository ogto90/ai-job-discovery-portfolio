{
  "name": "remotive-cli",
  "version": "1.0.0",
  "description": "CLI for searching Remotive's public remote jobs API.",
  "type": "module",
  "main": "src/cli.ts",
  "bin": {
    "remotive-search": "src/cli.ts"
  },
  "scripts": {
